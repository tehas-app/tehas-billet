{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/*.test.ts"],
  "exclude": ["packages/web"]
}
